    {
      "id": "2326903e0b283fec",
      "type": "text",
      "x": 2600,
      "y": 330,
      "width": 350,
      "height": 270,
      "text": "**● HUMAN** · book + web\n\n### [[People/Yann LeCun|Yann LeCun]]\n\nHinton postdoctoral alumnus; NYU professor and AMI Labs executive chairman in September 2026.\n\n[Profile / source](https://cims.nyu.edu/ai/events/919/)",
      "color": "#43A8D1"
